# Pour aller plus loin : renommer en node-pool.tf, puis appeler le module app avec node_selector = { role = "apps" }.
# Double les vCPU consommés : détruire dès que la démonstration est faite.
resource "azurerm_kubernetes_cluster_node_pool" "apps" {
  name                  = "apps"
  kubernetes_cluster_id = azurerm_kubernetes_cluster.main.id
  vm_size               = "Standard_B2s_v2"
  vnet_subnet_id        = azurerm_subnet.aks.id
  node_count            = 1
  node_labels = {
    role = "apps"
  }
}
